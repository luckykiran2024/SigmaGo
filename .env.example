# ==============================================================================
# SigmaGo Production Environment Variables Template (.env.example)
#
# NOTE: DO NOT commit actual secrets to version control.
# Configure these variables securely in your Coolify application environment panel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SUPABASE MANAGED PLATFORM
# ------------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. APPLICATION DOMAIN & PUBLIC URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------------------
# 3. EMAIL DISPATCH (RESEND)
# ------------------------------------------------------------------------------
EMAIL_FROM=
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 4. CRON & SCHEDULING SECURITY
# ------------------------------------------------------------------------------
CRON_SECRET=

# ------------------------------------------------------------------------------
# 5. PLATFORM CRYPTOGRAPHY & ASYMMETRIC SIGNING
# ------------------------------------------------------------------------------
PLATFORM_ADMIN_EMAILS=
PLATFORM_HISTORICAL_PUBLIC_KEYS_JSON=
PLATFORM_SIGNING_KEY_ID=
PLATFORM_SIGNING_PRIVATE_KEY_PEM=
SECRET_ACTIVE_KEY_VERSION=
SECRET_ENCRYPTION_KEY=
SECRET_KEY_RING=

# ------------------------------------------------------------------------------
# 6. REDIS & QUEUE TOPOLOGY
# ------------------------------------------------------------------------------
REDIS_URL=

# ------------------------------------------------------------------------------
# 7. WORKER RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
SIGMAGO_PROCESS_ROLE=web
ENABLE_OUTBOX_WORKER=false
WORKER_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 8. OPENTELEMETRY OBSERVABILITY
# ------------------------------------------------------------------------------
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=sigmago-web
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.version=0.1.0

# ------------------------------------------------------------------------------
# 9. ISOLATED QA FIXTURE RUNNER (PREVIEW/LOCAL ONLY)
# ------------------------------------------------------------------------------
# Never enable this in production. Tenant slugs must be explicitly allowlisted.
ENABLE_LIVE_TEST_RUNNER=false
LIVE_TEST_TENANT_ALLOWLIST=

