generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ActionToken {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token       String            @unique
  step_id     String            @db.Uuid
  approver_id String            @db.Uuid
  request_id  String            @db.Uuid
  tenant_id   String            @db.Uuid
  used_at     DateTime?         @db.Timestamptz(6)
  expires_at  DateTime          @db.Timestamptz(6)
  created_at  DateTime          @default(now()) @db.Timestamptz(6)
  approver    users             @relation(fields: [approver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  request     approval_requests @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  step        approval_steps    @relation(fields: [step_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant      tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("action_tokens")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model approval_requests {
  id                                                                           String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ref                                                                          String                   @unique @default(dbgenerated("((('REQ-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('request_seq'::regclass))::text, 4, '0'::text))"))
  tenant_id                                                                    String                   @db.Uuid
  owner_id                                                                     String                   @db.Uuid
  category_id                                                                  String                   @db.Uuid
  subject                                                                      String
  body_json                                                                    Json                     @default("{}")
  status                                                                       String                   @default("draft")
  visibility                                                                   String                   @default("private")
  version                                                                      Int                      @default(1)
  parent_id                                                                    String?                  @db.Uuid
  checksum_sha256                                                              String?
  conditions                                                                   Json                     @default("[]")
  created_at                                                                   DateTime                 @default(now()) @db.Timestamptz(6)
  finalized_at                                                                 DateTime?                @db.Timestamptz(6)
  search_vector                                                                Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, ((subject || ' '::text) || COALESCE((body_json ->> 'text'::text), ''::text)))"))
  archived                                                                     Boolean                  @default(false)
  beneficiary_id                                                               String?                  @db.Uuid
  custom_fields                                                                Json?                    @default("{}")
  valid_from                                                                   DateTime?                @db.Timestamptz(6)
  valid_until                                                                  DateTime?                @db.Timestamptz(6)
  review_date                                                                  DateTime?                @db.Timestamptz(6)
  renewed_from_id                                                              String?                  @db.Uuid
  action_tokens                                                                ActionToken[]
  users_approval_requests_beneficiary_idTousers                                users?                   @relation("approval_requests_beneficiary_idTousers", fields: [beneficiary_id], references: [id], onUpdate: NoAction)
  categories                                                                   categories               @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                                                        users                    @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approval_requests                                                            approval_requests?       @relation("approval_requestsToapproval_requests", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_approval_requests                                                      approval_requests[]      @relation("approval_requestsToapproval_requests")
  approval_requests_approval_requests_renewed_from_idToapproval_requests       approval_requests?       @relation("approval_requests_renewed_from_idToapproval_requests", fields: [renewed_from_id], references: [id], onUpdate: NoAction)
  other_approval_requests_approval_requests_renewed_from_idToapproval_requests approval_requests[]      @relation("approval_requests_renewed_from_idToapproval_requests")
  tenants                                                                      tenants                  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  approval_steps                                                               approval_steps[]
  attachments                                                                  attachments[]
  audit_log                                                                    audit_log[]
  view_grants                                                                  view_grants[]
  webhook_deliveries                                                           webhook_deliveries[]

  @@index([owner_id])
  @@index([search_vector], map: "approval_requests_search_idx", type: Gin)
  @@index([tenant_id, category_id])
  @@index([tenant_id, status])
  @@index([tenant_id, owner_id], map: "idx_requests_tenant_owner")
  @@index([beneficiary_id], map: "idx_approval_requests_beneficiary")
  @@index([valid_until], map: "idx_approval_requests_valid_until")
}

